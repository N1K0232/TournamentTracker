@page "/Tournaments/New"

@model CreateTournamentModel

<div x-data="tournaments" class="max-w-xl mx-auto p-6">
    <h1 class="mb-4">Create new tournament</h1>
    <div class="card shadow-sm">
        <form x-on:submit.prevent>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" x-model="name" class="form-control" required placeholder="Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Entry Fee (€)</label>
                    <input type="number" step="0.01" x-model="entryFee" class="form-control" required placeholder="Entry fee" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Starts at</label>
                    <input type="datetime" x-model="startsAt" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ends at</label>
                    <input type="datetime" x-model="endsAt" class="form-control" required />
                </div>
                <button class="btn" type="submit" x-on:click="create()" x-bind:disabled="isBusy">Create</button>
                <p x-show="errorMessage" x-text="errorMessage" class="text-danger mt-3"></p>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            createTournament('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}