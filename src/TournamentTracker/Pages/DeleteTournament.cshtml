@page "/Tournaments/Delete/{id:guid}"

@model DeleteTournamentModel

<div x-data="tournaments" class="container mt-5" x-init="get('@RouteData.Values["id"]')" x-cloak>
    <h1 class="mb-4 text-danger">Delete tournament</h1>
    <div x-show="isBusy">Loading...</div>
    <div class="card shadow-sm" x-show="!isBusy && tournament">
        <div class="card-body">
            <p class="fw-bold">Are you sure you want to delete this tournament?</p>
            <ul class="list-group mb-3">
                <li class="list-group-item"><strong>Name:</strong> <span x-text="tournament.name"></span></li>
                <li class="list-group-item"><strong>Starts at:</strong> <span x-text="new Date(tournament.startsAt).toLocaleString()"></span></li>
                <li class="list-group-item"><strong>Ends at:</strong> <span x-text="new Date(tournament.endsAt).toLocaleString()"></span></li>
                <li class="list-group-item"><strong>Entry fee:</strong> € <span x-text="tournament.entryFee"></span></li>
            </ul>
            <button @@click="delete('@RouteData.Values["id"]')" class="btn btn-danger">🗑 Delete</button>
            <a href="/" class="btn btn-secondary ms-2">Cancel</a>
            <p x-show="errorMessage" class="text-danger mt-3" x-text="errorMessage"></p>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            deleteTournament('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}