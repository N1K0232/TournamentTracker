@page "/Tournaments/Edit/{id:guid}"

@model EditTournamentModel

<div x-data="tournaments" x-init="get('@RouteData.Values["id"]')" x-cloak class="container mt-5">
    <h1 class="mb-4">Edit tournament</h1>
    <div x-show="isBusy">Loading...</div>
    <div class="card shadow-sm" x-show="!isBusy && tournament">
        <form x-on:submit.prevent>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input type="text" class="form-control" x-model="tournament.name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Entry Fee (€)</label>
                    <input type="number" step="0.01" class="form-control" x-model="tournament.entryFee" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Starts at</label>
                    <input type="datetime-local" class="form-control" x-model="startsAt" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Ends at</label>
                    <input type="datetime-local" class="form-control" x-model="endsAt" />
                </div>
                <button x-on:click="update('@RouteData.Values["id"]')" class="btn btn-success">💾 Save</button>
                <a href="/" class="btn btn-secondary ms-2">⬅ Back to home</a>
                <p x-show="errorMessage" class="text-danger mt-3" x-text="errorMessage"></p>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            updateTournament('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}