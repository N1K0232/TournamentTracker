@page

@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div x-data="tournaments" x-init="getList()" x-cloak>
    <template x-if="isBusy">
        <p>Loading...</p>
    </template>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" x-show="!isBusy">
        <template x-for="t in tournaments" :key="t.id">
            <div class="p-4 border rounded-lg shadow hover:shadow-lg hover:bg-gray-50 cursor-pointer transition" @@click="showDetails(t.id)">
                <h2 class="text-lg font-semibold" x-text="t.name"></h2>
                <p class="text-gray-600">
                    Entry fee: <span x-text="t.entryFee.toFixed(2)"></span>
                </p>
                <p class="text-gray-600">
                    Starts: <span x-text="new Date(t.startsAt).toLocaleDateString()"></span>
                </p>
                <p class="text-gray-600">
                    Ends: <span x-text="new Date(t.endsAt).toLocaleDateString()"></span>
                </p>
            </div>
        </template>
    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("alpine:init", () => {
            tournamentsList('@Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName');
        });
    </script>
}